# Supabase public credentials only — never put service_role or account passwords here
# Use the dedicated project named: athar

VITE_SUPABASE_URL=https://your-athar-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-athar-anon-public-key

# XPay Hosted Checkout does NOT need a Vite/public key.
# Never put sk_test_*, sk_live_*, whsec_*, or service_role keys in Vite env.
# The browser cannot choose XPAY_MODE; Edge Functions read it from secrets.
#
# Configure these only as Supabase Edge Function secrets:
#   XPAY_MODE=test
#   XPAY_SECRET_KEY=sk_test_...
#   XPAY_WEBHOOK_SECRET=whsec_...
#   STOREFRONT_URL=https://athar.qd.je
# Optional cutover only — HMAC overlap, never a mode bypass:
#   Set SECONDARY only after the other environment’s webhook endpoint exists.
#   Keep XPAY_MODE + XPAY_SECRET_KEY on one environment until you switch both.
#   A valid secondary signature still requires cs_test_/cs_live_ (and livemode)
#   to match XPAY_MODE. Remove SECONDARY as soon as the old Dashboard stops sending.
